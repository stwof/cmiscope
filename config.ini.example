# CMIScope example configuration.
# Copy to config.ini and edit, or override any key with a CMIS_* environment variable.
# Precedence: built-in defaults < config.ini < environment variables.
# No secrets belong in this file. Relative paths are resolved against base_dir.

[server]
host = 127.0.0.1
port = 8787

[paths]
data_dir = data
static_dir = cmis_service/static
db_file = data/cmis.db
seed_file = data/seed.json
kg_file = data/knowledge_graph.json
# Read-only CMIS 5.3 field reference. Optional: if missing, the /api/reference
# endpoints stay empty and the rest of the service is unaffected. Rebuild with
# python tools/import_cmis53.py after refreshing data/cmis53_dataset.json.
reference_file = data/cmis53_reference.json
# Editable target-device registry. If this file does not exist, the shipped
# config/targets.example.json is used; PUT /api/targets writes this path.
targets_file = config/targets.json

[app]
read_only = false
# access_mode selects exactly ONE physical access path:
#   mirror    - offline SQLite mirror, never touches hardware (default, safe)
#   ssh-i2c   - Mode A: SSH from the test server to the test switch, then I2C
#   rest-api  - Mode B: northbound RESTful API of the target device / NOS
# ssh+i2c and restful API are mutually exclusive: only the selected mode's
# [ssh] or [rest] block may be enabled, and the other is disabled at load time.
# This is the global fallback. Per-device modes and IP/port/credential-reference
# parameters live in config/targets.json (see [targets] notes below) and can be
# switched at runtime from the "Access targets" view or via /api/targets.
access_mode = mirror
# write_adapter is a backward-compatible alias for access_mode
write_adapter = mirror
# UI language: zh (default) or en; the browser can switch at runtime
default_language = zh
operator = local-admin

# ---------------------------------------------------------------------------
# Transport blocks are STRICTLY MUTUALLY EXCLUSIVE.
# Enable exactly one block, and uncomment it together with the matching
# access_mode above. Leave the other block commented out. The service also
# blanks the unselected transport at load time, so it can never take effect.
# With access_mode = mirror (the safe default) keep BOTH blocks commented out.
#
# Mode A: test server -> SSH -> test switch -> I2C -> module EEPROM (0x50)
# Uses the system ssh binary with BatchMode=yes, so an existing ssh-agent key
# or an SSH config entry is expected. Command templates are argv templates
# (shlex-split, never a shell); placeholders are whitelisted values.
# ---------------------------------------------------------------------------
# [ssh]
# host = 10.0.0.2
# user = admin
# port = 22
# timeout_seconds = 8
# i2c_bus = 0
# i2c_addr = 0x50
# probe_cmd = ssh -p {port} -o BatchMode=yes -o ConnectTimeout={timeout} {user}@{host} echo CMIS-PROBE-OK
# read_cmd = ssh -p {port} -o BatchMode=yes -o ConnectTimeout={timeout} {user}@{host} i2cdump -y {bus} {addr} b
# write_cmd = ssh -p {port} -o BatchMode=yes -o ConnectTimeout={timeout} {user}@{host} i2cset -y {bus} {addr} {offset} {value}
# cdb_cmd =

# ---------------------------------------------------------------------------
# Mode B: target device RESTful API. The token is read from the environment
# variable named by token_env (it is never stored here or returned by the API).
# To use this mode: comment out the [ssh] block above, uncomment this one, and
# set access_mode = rest-api.
# ---------------------------------------------------------------------------
# [rest]
# base_url = https://10.0.0.9/api
# token_env = CMIS_REST_TOKEN
# timeout_seconds = 8
# probe_path = /api/cmis/health
# read_path = /api/cmis/registers
# write_path = /api/cmis/registers
# cdb_path = /api/cmis/cdb

# ---------------------------------------------------------------------------
# Safety gates. All are OFF by default.
# Lower Memory (0-127) and CDB pages 9Fh-AFh are never remotely writable,
# following IETF draft-hi-ccamp-cmis-control-yang-04 section 9.1.
# ---------------------------------------------------------------------------
[security]
allow_hardware_write = false
cdb_allow_firmware = false
cdb_rest_allowed = false
cdb_confirm_token = EXECUTE

[limits]
max_body_bytes = 65536
log_level = INFO

# ---------------------------------------------------------------------------
# Editable target registry (new devices join without any code change).
# Edit config/targets.json directly, or use the dashboard / PUT /api/targets.
# Fields per target: device_id, name, enabled, access_mode, host, port,
#   module_ids, notes, plus ONLY the selected mode's fields:
#   ssh-i2c  -> ssh_user, i2c_bus, i2c_addr
#   rest-api -> rest_scheme, rest_base_path, token_env
#   mirror   -> none of the above
# A target carrying both transports' fields is rejected on save.
# Credentials are NEVER stored here: token_env names an environment variable
# (for example CMIS_REST_TOKEN), and SSH reuses ssh-agent keys with BatchMode.
# CMIS_TARGETS_FILE overrides targets_file; CMIS_REST_TOKEN carries the token.
# ---------------------------------------------------------------------------
